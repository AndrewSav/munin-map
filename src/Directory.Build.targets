<!-- patches: TASK-4 (TASK-4.6). Fork only (see PATCHES.md): MSBuild imports this file into MuninMap.csproj
     by itself, so upstream's project file stays as it is.
     In-place ore prediction (Patches/InPlaceOre.cs) reads the game's colliders and physics query
     settings, which are in UnityEngine.PhysicsModule. -->
<Project>
  <ItemGroup>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>..\libs\valheim\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
</Project>
