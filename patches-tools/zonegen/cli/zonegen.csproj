<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-4.2: zonegen, a standalone CLI that generates a copy of a Valheim world headless and writes
     out its ore deposits. Fork tooling, not shipped in Munin. Publish (self-contained, one file):
       dotnet publish -c Release -r win-x64    |    dotnet publish -c Release -r linux-x64
     The ZoneGen plugin (../plugin) is built first and embedded. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>zonegen</AssemblyName>
    <RootNamespace>ZoneGenCli</RootNamespace>
    <Version>0.1.0</Version>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
    <PluginDll>$(MSBuildThisFileDirectory)..\plugin\bin\Release\ZoneGen.dll</PluginDll>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <Target Name="BuildPlugin" BeforeTargets="PrepareForBuild">
    <Exec Command="dotnet build &quot;$(MSBuildThisFileDirectory)..\plugin\ZoneGen.csproj&quot; -c Release -nologo -v q" />
  </Target>
  <ItemGroup>
    <EmbeddedResource Include="$(PluginDll)" LogicalName="ZoneGen.dll" />
  </ItemGroup>
</Project>
