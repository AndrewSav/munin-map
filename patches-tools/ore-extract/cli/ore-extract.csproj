<?xml version="1.0" encoding="utf-8"?>
<!-- TASK-4.2: ore-extract, a CLI that generates a copy of a Valheim world headless and writes out its
     ore deposits. Fork tooling (TASK-4.7): the reference in-place prediction is measured against.
     Built by ../build.sh:
       dotnet publish -c Release -r win-x64    |    dotnet publish -c Release -r linux-x64
     The supervisor is in ../core, which builds and embeds the OreExtract plugin (../plugin). -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <AssemblyName>ore-extract</AssemblyName>
    <RootNamespace>OreExtractCli</RootNamespace>
    <Version>0.0.0-local</Version>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <InvariantGlobalization>true</InvariantGlobalization>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NuGetAudit>false</NuGetAudit>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
    <PublishSingleFile>true</PublishSingleFile>
    <PublishTrimmed>true</PublishTrimmed>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../core/OreExtract.Core.csproj" />
  </ItemGroup>
</Project>
